{
  "name": "android-rom-compat",
  "version": "0.1.0",
  "private": true,
  "description": "Which Android ROMs run on which phones, and what actually works",
  "homepage": "https://android-rom-compat.peng.ly",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate.js",
    "import": "node scripts/import/run.js",
    "build": "npm run validate && astro build && pagefind --site dist --glob \"{devices/*/*,roms/*}/index.html\"",
    "preview": "astro preview",
    "test": "node --test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pagefind": "^1.5.2",
    "yaml": "^2.9.1"
  }
}
