---
import Base from '../../components/layout/Base.astro';
import PageHead from '../../components/layout/PageHead.astro';
import CardGrid from '../../components/cards/CardGrid.astro';
import FeatureList from '../../components/cards/FeatureList.astro';
import Matrix from '../../components/table/Matrix.astro';
import Facts from '../../components/ui/Facts.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import Icon from '../../components/ui/Icon.astro';
import { getModel } from '../../lib/data/model.js';
import { byBrand, romDeviceCard } from '../../lib/cards.js';
import { everywhereCells, googleApps, knownFeatures, romRelock } from '../../lib/facts.js';
import {
  filterData,
  reportedFeatures,
  splitByActive,
  supportCells,
  supportColumns,
  sameOnEveryRow,
  usedColumns,
} from '../../lib/table.js';
import { labelOf, yesNo } from '../../lib/labels.js';
import { plural } from '../../lib/text.js';

export const getStaticPaths = () =>
  getModel().roms.map((rom) => ({ params: { rom: rom.key }, props: { rom } }));

const { rom } = Astro.props;
const { features } = getModel();
const reported = reportedFeatures(features, rom.support);
const [current, ended] = splitByActive(rom.support);
const brands = [
  ...new Map(current.map((row) => [row.device.brand.key, row.device.brand])).values(),
].sort((a, b) => a.name.localeCompare(b.name));
const groupsOf = (list) => byBrand(list, (row) => row.device.brand, romDeviceCard);
const rowsOf = (list) =>
  list.map((row) => ({
    key: row.device.key,
    data: filterData(row.device, false),
    head: {
      label: row.device.title,
      href: row.device.url,
      code: row.device.codenames.join(', '),
      links: row.install ? [{ label: 'Install guide', href: row.install }] : [],
    },
    cells: { brand: { text: row.device.brand.name }, ...supportCells(row, reported) },
  }));
const currentRows = rowsOf(current);
const endedRows = rowsOf(ended);
const allRows = [...currentRows, ...endedRows];
const columns = usedColumns(
  [{ key: 'brand', label: 'Brand', group: 'device', hidden: true }, ...supportColumns(reported)],
  allRows,
).filter(({ key }) => key !== 'relock' || !sameOnEveryRow(allRows, key));
const everywhere = [rom, ...(rom.variants ?? [])]
  .map((build) => ({ build, items: knownFeatures(features, everywhereCells(features, build)) }))
  .filter(({ items }) => items.length > 0);
const { links, security } = rom;
const count = plural(current.length, 'device');
---

<Base
  title={`${rom.name}: supported devices`}
  description={rom.description}
  crumbs={[
    { label: 'ROMs', url: '/roms/' },
    { label: rom.name, url: rom.url },
  ]}
  jsonLd={[
    {
      '@type': 'SoftwareApplication',
      name: rom.name,
      description: rom.description,
      applicationCategory: 'OperatingSystem',
      operatingSystem: 'Android',
      url: links.website,
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'GBP' },
    },
  ]}
  edit={[rom.file]}
>
  <article data-pagefind-body data-pagefind-meta={`hint:ROM · ${count}`}>
    <PageHead
      title={rom.name}
      logo={{ kind: 'roms', item: rom }}
      meta={[count, rom.status === 'discontinued' && 'Discontinued']}
      views={current.length > 0}
    >
      <p>{rom.description}</p>
      <ul class="links">
        {Object.entries(links).map(([kind, href]) => (
          <li>
            <a class="button small" href={href}>
              <Icon name={kind} /> {labelOf(kind)}
            </a>
          </li>
        ))}
      </ul>
    </PageHead>

    <section aria-labelledby="glance">
      <h2 id="glance">At a glance</h2>
      <Facts
        items={[
          { label: 'Google apps', value: googleApps(rom) },
          { label: 'App store', value: labelOf(rom.app_store) },
          { label: 'Based on', value: labelOf(rom.base) },
          { label: 'Install with', value: rom.install.map(labelOf).join(', ') },
          { label: 'Relockable bootloader', value: romRelock(rom) },
          { label: 'Verified boot', value: yesNo(security.verified_boot) },
          { label: 'Security patches', value: labelOf(security.patches) },
          { label: 'Root', value: yesNo(rom.root) },
          { label: 'Run by', value: labelOf(rom.org) },
          { label: 'Focus', value: rom.focus.map(labelOf).join(', ') },
        ]}
      />
    </section>

    {everywhere.length > 0 && (
      <section aria-labelledby="everywhere">
        <h2 id="everywhere">On every device</h2>
        {everywhere.map(({ build, items }) => (
          <>
            {build !== rom && <h3>{build.name}</h3>}
            <FeatureList items={items} />
          </>
        ))}
      </section>
    )}

    <section aria-labelledby="devices" data-pagefind-ignore>
      <h2 id="devices">
        Devices <span class="count">{current.length}</span>
      </h2>
      {current.length > 0 ? (
        <div class="filtered">
          <FilterBar
            controls={['rom-devices-cards', 'rom-devices']}
            label="Filter devices"
            total={current.length}
            brands={brands}
          />
          <div data-view="cards">
            <CardGrid id="rom-devices-cards" groups={groupsOf(current)} level={3} />
          </div>
          <div data-view="table">
            <Matrix
              id="rom-devices"
              caption={`Devices ${rom.name} officially supports`}
              rowLabel="Device"
              columns={columns}
              rows={currentRows}
              urlState
            />
          </div>
        </div>
      ) : (
        <p>{rom.name} doesn't officially support any devices right now.</p>
      )}
      {ended.length > 0 && (
        <details>
          <summary>{plural(ended.length, 'device')} where support has ended</summary>
          <div data-view="cards">
            <CardGrid id="rom-ended-cards" groups={groupsOf(ended)} level={3} />
          </div>
          <div data-view="table">
            <Matrix
              id="rom-devices-ended"
              caption={`Devices ${rom.name} no longer supports`}
              rowLabel="Device"
              columns={columns}
              rows={endedRows}
              controls={false}
            />
          </div>
        </details>
      )}
    </section>
  </article>
</Base>

<style>
  article {
    display: grid;
    gap: var(--space-xl);
  }

  h3 {
    margin-block-start: var(--space-sm);
  }

  .count {
    margin-inline-start: var(--space-2xs);
    color: var(--text-muted);
    font-weight: 400;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-xs) 0 0;
    padding: 0;
    list-style: none;
  }

  details[open] > summary {
    margin-block-end: var(--space-md);
  }
</style>
