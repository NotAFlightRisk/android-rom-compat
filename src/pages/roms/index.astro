---
import Base from '../../components/layout/Base.astro';
import PageHead from '../../components/layout/PageHead.astro';
import RomSummary from '../../components/cards/RomSummary.astro';
import Matrix from '../../components/table/Matrix.astro';
import { getModel } from '../../lib/data/model.js';
import { romCells, romColumns } from '../../lib/table.js';
import { listOf } from '../../lib/text.js';

const { roms } = getModel();
const columns = [{ key: 'devices', label: 'Devices' }, ...romColumns];
const rowsOf = (list) =>
  list.map((rom) => ({
    key: rom.key,
    head: { label: rom.name, href: rom.url },
    cells: { devices: { text: rom.activeCount }, ...romCells(rom) },
  }));
const live = roms.filter((rom) => rom.status === 'active');
const gone = roms.filter((rom) => rom.status !== 'active');
---

<Base
  title="Android ROMs compared"
  description={`${listOf(
    live.map((rom) => rom.name),
    'and',
  )} side by side: Google apps, security, install methods and supported devices.`}
  crumbs={[{ label: 'ROMs', url: '/roms/' }]}
>
  <PageHead title="ROMs" meta={[`${live.length} ROMs, official builds only`]} views />
  <div data-view="cards">
    <ul class="roms">
      {live.map((rom) => (
        <li>
          <RomSummary rom={rom} level={2} />
        </li>
      ))}
    </ul>
  </div>
  <div data-view="table">
    <Matrix
      id="roms"
      caption="ROMs side by side"
      rowLabel="ROM"
      columns={columns}
      rows={rowsOf(live)}
      urlState
    />
  </div>
  {gone.length > 0 && (
    <details>
      <summary>Discontinued ROMs</summary>
      <Matrix
        id="roms-gone"
        caption="Discontinued ROMs"
        rowLabel="ROM"
        columns={columns}
        rows={rowsOf(gone)}
        controls={false}
      />
    </details>
  )}
</Base>

<style>
  .roms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;

    > li {
      display: grid;
    }
  }
</style>
