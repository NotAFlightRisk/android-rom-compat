---
import Base from '../../../components/layout/Base.astro';
import PageHead from '../../../components/layout/PageHead.astro';
import DeviceList from '../../../components/ui/DeviceList.astro';
import Facts from '../../../components/ui/Facts.astro';
import { getModel } from '../../../lib/data/model.js';
import { unlockFact } from '../../../lib/facts.js';
import { plural } from '../../../lib/text.js';

export const getStaticPaths = () =>
  getModel().brands.map((brand) => ({ params: { brand: brand.key }, props: { brand } }));

const { brand } = Astro.props;
const { roms } = getModel();
const romNames = [
  ...new Set(brand.devices.flatMap((device) => device.support.map((row) => row.rom.name))),
];
const policy = brand.bootloader && unlockFact({ bootloader: brand.bootloader, brand: {} });
---

<Base
  title={`${brand.name} phones: custom ROM support`}
  description={`Which custom ROMs run on ${brand.name} phones${romNames.length ? `: ${romNames.join(', ')}` : ''}.`}
  crumbs={[
    { label: 'Devices', url: '/devices/' },
    { label: brand.name, url: brand.url },
  ]}
  edit={['data/brands.yml']}
>
  <PageHead
    title={brand.name}
    logo={{ kind: 'brands', item: brand }}
    meta={[
      plural(brand.devices.length, 'device'),
      brand.website && { text: new URL(brand.website).hostname, href: brand.website },
    ]}
    views
  />
  {policy && (
    <Facts
      panel
      items={[
        {
          label: 'Bootloader policy',
          ...policy,
          text: policy.text ?? policy.note,
          note: policy.text && policy.note,
        },
      ]}
    />
  )}
  <DeviceList
    id="brand-devices"
    label={`${brand.name} devices`}
    devices={brand.devices}
    roms={roms}
  />
</Base>
