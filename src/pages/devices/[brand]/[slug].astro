---
import Base from '../../../components/layout/Base.astro';
import PageHead from '../../../components/layout/PageHead.astro';
import RomCard from '../../../components/cards/RomCard.astro';
import Matrix from '../../../components/table/Matrix.astro';
import Facts from '../../../components/ui/Facts.astro';
import Logo from '../../../components/ui/Logo.astro';
import { getModel } from '../../../lib/data/model.js';
import {
  featuresFrom,
  reportUrl,
  romCells,
  romColumns,
  splitByActive,
  supportCells,
  supportColumns,
  usedColumns,
} from '../../../lib/table.js';
import { buildFact, stockFact, unlockFact } from '../../../lib/facts.js';
import { formatDate } from '../../../lib/dates.js';
import { labelOf } from '../../../lib/labels.js';
import { listOf } from '../../../lib/text.js';

export const getStaticPaths = () =>
  getModel().devices.map((device) => ({
    params: { brand: device.brand.key, slug: device.slug },
    props: { device },
  }));

const { device } = Astro.props;
const { features } = getModel();
const { stock, support } = device;
const [current, ended] = splitByActive(support);
const unlock = unlockFact(device);
const updates = stockFact(stock);
const quiet = new Set(
  [...featuresFrom(features, support, 'none'), ...featuresFrom(features, support, 'hardware')].map(
    ({ key }) => key,
  ),
);

const rowsOf = (list) =>
  list.map((row) => ({
    key: row.rom.key,
    head: {
      label: row.rom.name,
      href: row.rom.url,
      links: [
        ...(row.install ? [{ label: 'Install guide', href: row.install }] : []),
        { label: 'Report', href: reportUrl(device, row.rom) },
      ],
      builds: row.variants
        .filter((variant) => variant.status === 'active')
        .map((variant) => ({
          label: [variant.name, variant.latest && formatDate(variant.latest.date)]
            .filter(Boolean)
            .join(', '),
          href: variant.source,
        })),
    },
    cells: { ...supportCells(row, features, true), ...romCells(row.rom) },
  }));
const currentRows = rowsOf(current);
const endedRows = rowsOf(ended);
const columns = usedColumns(
  [
    ...supportColumns(features, true).map((column) => ({
      ...column,
      hidden: quiet.has(column.key),
    })),
    ...romColumns.map((column) => ({ ...column, group: 'rom', hidden: true })),
  ],
  [...currentRows, ...endedRows],
);

const type = device.type && device.type !== 'phone' ? labelOf(device.type) : undefined;
const romNames = current.map((row) => row.rom.name);
const codename = device.codenames[0];
---

<Base
  title={`${device.title} (${codename}): custom ROM support`}
  description={
    romNames.length
      ? `Which ROMs run on the ${device.title} and what works: ${listOf(romNames, 'and')}.`
      : `Custom ROM support for the ${device.title} (${codename}), and whether its bootloader unlocks.`
  }
  crumbs={[
    { label: 'Devices', url: '/devices/' },
    { label: device.brand.name, url: device.brand.url },
    { label: device.name, url: device.url },
  ]}
  jsonLd={[
    {
      '@type': 'Product',
      name: device.title,
      brand: { '@type': 'Brand', name: device.brand.name },
      model: codename,
      ...(device.aliases?.length && { mpn: device.aliases[0] }),
      ...(device.released && { releaseDate: String(device.released) }),
    },
  ]}
  edit={[device.file, ...support.map((row) => row.file).filter(Boolean)]}
  sources={support
    .filter((row) => row.generated)
    .map((row) => ({ label: row.rom.name, href: row.source }))}
>
  <article
    data-pagefind-body
    data-pagefind-meta={`hint:${device.brand.name} · ${device.codenames.join(', ')}`}
  >
    <PageHead
      title={device.title}
      logo={{ kind: 'brands', item: device.brand }}
      meta={[
        { text: device.codenames.join(', '), code: true },
        device.released && `Released ${device.released}`,
        device.soc,
        type,
      ]}
      views={current.length > 0}
    >
      {device.aliases?.length > 0 && (
        <p class="models">
          Model numbers <code>{device.aliases.join(', ')}</code>
        </p>
      )}
    </PageHead>

    <Facts
      panel
      items={[
        { label: 'Bootloader', value: unlock.text, ...unlock },
        updates && { label: 'Stock Android', value: updates.text, ...updates },
      ].filter(Boolean)}
    />

    <section aria-labelledby="roms">
      <h2 id="roms">ROMs {current.length > 0 && <span class="count">{current.length}</span>}</h2>
      {current.length > 0 ? (
        <>
          <div data-view="cards">
            <ul class="roms">
              {current.map((row) => (
                <li>
                  <RomCard row={row} features={features} />
                </li>
              ))}
            </ul>
          </div>
          <div data-view="table" data-pagefind-ignore>
            <Matrix
              id="support"
              caption={`ROMs for the ${device.title}`}
              rowLabel="ROM"
              columns={columns}
              rows={currentRows}
              urlState
            />
          </div>
        </>
      ) : (
        <p>
          None of the ROMs listed here officially supports this device right now. Know of one?{' '}
          <a href="/contribute/">Add it</a>.
        </p>
      )}
    </section>

    {ended.length > 0 && (
      <section aria-labelledby="ended">
        <h2 id="ended">No longer supported</h2>
        <div data-view="cards">
          <ul class="ended">
            {ended.map((row) => {
              const build = buildFact(row.latest);
              return (
                <li>
                  <Logo kind="roms" item={row.rom} size="sm" />
                  <a href={row.rom.url}>{row.rom.name}</a>
                  {build && (
                    <span>
                      Last build <time datetime={build.date}>{build.text}</time>
                      {row.android && `, Android ${row.android}`}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
        <div data-view="table" data-pagefind-ignore>
          <Matrix
            id="support-ended"
            caption={`Ended support for the ${device.title}`}
            rowLabel="ROM"
            columns={columns}
            rows={endedRows}
            controls={false}
          />
        </div>
      </section>
    )}

    {support.length > 0 && (
      <p class="report">
        <a href={reportUrl(device)}>Tried a ROM on this device? Tell us what works</a>
      </p>
    )}
  </article>
</Base>

<style>
  article {
    display: grid;
    gap: var(--space-xl);
  }

  .models {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .count {
    margin-inline-start: var(--space-2xs);
    color: var(--text-muted);
    font-weight: 400;
  }

  .roms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;

    > li {
      display: grid;
    }
  }

  .ended {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2xs) var(--space-sm);
      padding-block: var(--space-xs);
      border-block-end: 1px solid var(--border);
    }

    span {
      color: var(--text-muted);
      font-size: var(--text-sm);
    }
  }

  .report {
    font-size: var(--text-sm);
  }
</style>
