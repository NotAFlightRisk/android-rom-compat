---
import Base from '../../../components/layout/Base.astro';
import Matrix from '../../../components/table/Matrix.astro';
import Facts from '../../../components/ui/Facts.astro';
import { getModel } from '../../../lib/data/model.js';
import {
  featuresFrom,
  reportUrl,
  romCells,
  romColumns,
  splitByActive,
  supportCells,
  supportColumns,
  usedColumns,
} from '../../../lib/table.js';
import { labelOf } from '../../../lib/labels.js';
import { listOf } from '../../../lib/text.js';
import { today } from '../../../lib/dates.js';

export const getStaticPaths = () =>
  getModel().devices.map((device) => ({
    params: { brand: device.brand.key, slug: device.slug },
    props: { device },
  }));

const { device } = Astro.props;
const { features } = getModel();
const { bootloader, stock, support } = device;
const [current, ended] = splitByActive(support);
const unreported = featuresFrom(features, support, 'none');
const quiet = new Set(
  [...unreported, ...featuresFrom(features, support, 'hardware')].map(({ key }) => key),
);

const rowsOf = (list) =>
  list.map((row) => ({
    key: row.rom.key,
    search: row.rom.name.toLowerCase(),
    head: {
      label: row.rom.name,
      href: row.rom.url,
      links: [
        ...(row.install ? [{ label: 'Install guide', href: row.install }] : []),
        { label: 'Report', href: reportUrl(device, row.rom) },
      ],
      builds: row.variants.map((variant) => ({
        label: [`${labelOf(variant.key)} build`, variant.latest?.date].filter(Boolean).join(', '),
        href: variant.source,
      })),
    },
    cells: { ...supportCells(row, features, true), ...romCells(row.rom) },
  }));
const currentRows = rowsOf(current);
const endedRows = rowsOf(ended);
const columns = usedColumns(
  [
    ...supportColumns(features, true).map((column) => ({
      ...column,
      hidden: quiet.has(column.key),
    })),
    ...romColumns.map((column) => ({ ...column, group: 'rom', hidden: true })),
  ],
  [...currentRows, ...endedRows],
);

const monthOf = (date) =>
  new Date(date).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const stockLine = ({ android, security_until, updates_until }) => {
  const until = security_until ?? updates_until;
  if (until === 'ended' || until < today) return 'Stock updates have ended';
  const range = android ? `Stock Android ${android.replace(' - ', ' to ')}` : 'Stock';
  const kind = security_until ? 'security updates' : 'updates';
  return until ? `${range}, ${kind} until ${monthOf(until)}` : range;
};

const gaps =
  unreported.length === features.length
    ? "Nobody's reported any features on this phone yet."
    : `Nobody's reported ${listOf(unreported.map(({ name }) => name))} on this phone yet.`;
const type = device.type && device.type !== 'phone' ? labelOf(device.type) : undefined;
const romNames = current.map((row) => row.rom.name);
const codename = device.codenames[0];
---

<Base
  title={`${device.title} (${codename}): custom ROM support`}
  description={
    romNames.length
      ? `Which ROMs run on the ${device.title} and what works: ${listOf(romNames, 'and')}.`
      : `Custom ROM support for the ${device.title} (${codename}), and whether its bootloader unlocks.`
  }
  crumbs={[
    { label: 'Devices', url: '/devices/' },
    { label: device.brand.name, url: device.brand.url },
    { label: device.name, url: device.url },
  ]}
  jsonLd={[
    {
      '@type': 'Product',
      name: device.title,
      brand: { '@type': 'Brand', name: device.brand.name },
      model: codename,
      ...(device.aliases?.length && { mpn: device.aliases[0] }),
      ...(device.released && { releaseDate: String(device.released) }),
    },
  ]}
  edit={[device.file, ...support.map((row) => row.file).filter(Boolean)]}
  sources={support
    .filter((row) => row.generated)
    .map((row) => ({ label: row.rom.name, href: row.source }))}
>
  <article
    data-pagefind-body
    data-pagefind-meta={`hint:${device.brand.name} · ${device.codenames.join(', ')}`}
  >
    <section>
      <h1 data-pagefind-meta="title">{device.title}</h1>
      <Facts
        items={[
          {
            label: device.codenames.length > 1 ? 'Codenames' : 'Codename',
            value: device.codenames.join(', '),
            code: true,
          },
          { label: 'Model numbers', value: device.aliases?.join(', '), code: true },
          { label: 'Released', value: device.released },
          { label: 'Chip', value: device.soc },
          { label: 'Type', value: type },
        ]}
      />
      {stock && (
        <p>
          {stockLine(stock)}, going by <a href={stock.source}>{new URL(stock.source).hostname}</a>.
        </p>
      )}
    </section>

    <section aria-labelledby="bootloader">
      <h2 id="bootloader">Bootloader</h2>
      <Facts items={[{ label: 'Unlock', value: labelOf(bootloader.unlock) }]} />
      {bootloader.notes && <p>{bootloader.notes}</p>}
    </section>

    <section aria-labelledby="roms">
      <h2 id="roms">ROMs</h2>
      {current.length > 0 ? (
        <Matrix
          id="support"
          caption={`ROMs for the ${device.title}`}
          rowLabel="ROM"
          columns={columns}
          rows={currentRows}
          urlState
        />
      ) : (
        <p>
          No ROM we track officially supports this one right now. Know different?{' '}
          <a href="/contribute/">Add it</a>.
        </p>
      )}
      {ended.length > 0 && (
        <details>
          <summary>
            Support that has ended (
            {listOf(
              ended.map((row) => row.rom.name),
              'and',
            )}
            )
          </summary>
          <Matrix
            id="support-ended"
            caption={`Ended support for the ${device.title}`}
            rowLabel="ROM"
            columns={columns}
            rows={endedRows}
            controls={false}
          />
        </details>
      )}
      {support.length > 0 && unreported.length > 0 && (
        <p>
          <small>
            {gaps}{' '}
            <a href={reportUrl(device)}>Tried one?</a>
          </small>
        </p>
      )}
    </section>
  </article>
</Base>

<style>
  article {
    display: grid;
    gap: var(--space-xl);
  }
</style>
