---
import Base from '../../components/layout/Base.astro';
import DeviceTables from '../../components/ui/DeviceTables.astro';
import { getModel } from '../../lib/data/model.js';

const { devices, roms, brands } = getModel();
---

<Base
  title="Devices"
  description={`${devices.length} Android phones and tablets, the custom ROMs that officially support each one, and whether the bootloader unlocks.`}
  crumbs={[{ label: 'Devices', url: '/devices/' }]}
>
  <section>
    <h1>Devices</h1>
    <details>
      <summary>Browse by brand</summary>
      <ul class="brands">
        {brands.map((brand) => (
          <li>
            <a href={brand.url}>{brand.name}</a> <span>{brand.devices.length}</span>
          </li>
        ))}
      </ul>
    </details>
  </section>
  <DeviceTables
    id="devices"
    label="Devices"
    devices={devices}
    roms={roms}
    brands={brands}
    ended={false}
  />
</Base>

<style>
  .brands {
    display: flex;
    margin-block-start: var(--space-sm);
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    padding: 0;
    list-style: none;

    span {
      color: var(--text-muted);
      font-size: var(--text-sm);
    }
  }
</style>
