---
import Base from '../../components/layout/Base.astro';
import PageHead from '../../components/layout/PageHead.astro';
import DeviceList from '../../components/ui/DeviceList.astro';
import { getModel } from '../../lib/data/model.js';

const { devices, roms, brands } = getModel();
---

<Base
  title="Devices"
  description={`${devices.length} Android phones and tablets, the custom ROMs that officially support each one, and whether the bootloader unlocks.`}
  crumbs={[{ label: 'Devices', url: '/devices/' }]}
>
  <PageHead
    title="Devices"
    meta={[`${devices.length} phones, tablets and handhelds`, `${brands.length} brands`]}
    views
  />
  <DeviceList id="devices" label="Devices" devices={devices} roms={roms} brands={brands} />
</Base>
