---
import Base from '../components/layout/Base.astro';
import PageHead from '../components/layout/PageHead.astro';
import Icon from '../components/ui/Icon.astro';
import { site, issueUrl } from '../lib/site.js';

const forms = [
  {
    template: 'report-feature',
    icon: 'report',
    label: 'Report what works',
    hint: 'VoLTE, NFC, Android Auto and the rest, on one ROM and phone',
  },
  {
    template: 'add-device',
    icon: 'device',
    label: 'Add a device',
    hint: "A phone or tablet a ROM officially supports, but we don't list",
  },
  { template: 'correction', icon: 'fix', label: 'Fix a mistake', hint: 'Anything wrong on a page' },
];

const steps = [
  [
    'You fill in the form',
    "Starting from a device page? Each ROM's Report button fills in the device, ROM and Android version.",
  ],
  [
    'A bot checks it',
    "If something's missing, it comments on the issue saying what, and tries again when you edit it.",
  ],
  ['It opens a pull request', 'With your name on the commit.'],
];

const guidelines = [
  [
    'Always link a source',
    `A ROM's own device page, wiki or changelog is best. A "works for me" from a forum is fine too, just say so in a note.`,
  ],
  [
    "Don't guess",
    "If you can't back something up, leave it out. It shows as unknown, and a gap is better than a wrong answer.",
  ],
  [
    'Note what goes wrong',
    "Anything that only partly works, or doesn't work, needs a note saying what.",
  ],
];
---

<Base
  narrow
  title="Contribute"
  description="Add a device, report what works on a ROM, or fix a mistake. Everything lives in YAML files on GitHub."
  crumbs={[{ label: 'Contribute', url: '/contribute/' }]}
>
  <PageHead title="Contribute">
    <p class="lede">
      All the data is plain YAML on GitHub, so anyone can add to it, no coding needed. Fill in a
      form, or edit the files yourself.
    </p>
  </PageHead>

  <section aria-labelledby="forms">
    <h2 id="forms">Fill in a form</h2>
    <p>The quickest way. Forms open on GitHub, so you'll need an account there.</p>
    <ul class="forms">
      {forms.map((form) => (
        <li class="card">
          <span class="glyph">
            <Icon name={form.icon} />
          </span>
          <div>
            <h3>
              <a class="stretch" href={issueUrl(form.template)}>
                {form.label}
              </a>
            </h3>
            <p>{form.hint}</p>
          </div>
          <Icon name="external" />
        </li>
      ))}
    </ul>
    <details>
      <summary>What happens to a report?</summary>
      <ol class="steps">
        {steps.map(([title, text]) => (
          <li>
            <strong>{title}</strong>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </details>
    <p class="aside">
      Got a question, or a ROM we should track?{' '}
      <a href={`${site.repo}/discussions`}>Ask in Discussions</a>.
    </p>
  </section>

  <section aria-labelledby="edit">
    <h2 id="edit">Or edit the data yourself</h2>
    <p>
      The contributing guide shows where each file lives, what to copy, and how to check your
      change. You can do the whole thing in GitHub's web editor, and every device and ROM page links
      to its files at the bottom.
    </p>
    <a class="button" href={`${site.repo}/blob/main/.github/CONTRIBUTING.md`}>
      <Icon name="docs" /> Contributing guide
    </a>
    <details>
      <summary>Before you edit</summary>
      <dl class="pairs">
        {guidelines.map(([title, text]) => (
          <div>
            <dt>{title}</dt>
            <dd>{text}</dd>
          </div>
        ))}
        <div>
          <dt>
            Leave <code>data/upstream/</code> alone
          </dt>
          <dd>
            It's rebuilt from each ROM's own device list every Monday, so edits there don't last a
            week. If it's wrong, it's wrong at the source, so{' '}
            <a href={issueUrl('correction')}>tell us with the fix a mistake form</a>.
          </dd>
        </div>
      </dl>
    </details>
  </section>
</Base>

<style>
  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li p,
  .aside {
    color: var(--text-muted);
  }

  .forms {
    display: grid;
    gap: var(--space-xs);

    li {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-md);

      > :global(svg) {
        color: var(--text-muted);
        transition:
          color 150ms ease-out,
          translate 150ms ease-out;
      }

      &:hover > :global(svg) {
        color: var(--accent-text);
        translate: 2px -2px;
      }
    }

    h3 {
      font-size: var(--text-base);
    }

    p {
      font-size: var(--text-sm);
    }

    .stretch {
      color: var(--text);
      text-decoration: none;
    }
  }

  .glyph {
    display: grid;
    place-items: center;
    inline-size: var(--control);
    block-size: var(--control);
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: 1.25rem;
  }

  .aside {
    font-size: var(--text-sm);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-md) var(--space-lg);
    counter-reset: step;

    li {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      align-content: start;
      gap: var(--space-2xs) var(--space-xs);
      counter-increment: step;

      &::before {
        content: counter(step);
        display: inline-grid;
        place-items: center;
        inline-size: 1.25rem;
        block-size: 1.25rem;
        border: 1px solid transparent;
        border-radius: var(--radius-pill);
        background: var(--accent-soft);
        color: var(--accent-text);
        font-size: var(--text-xs);
        font-weight: 600;
      }
    }

    strong {
      font-weight: 600;
    }

    p {
      grid-column: 2;
    }
  }

  .button {
    justify-self: start;
  }
</style>
