---
import Base from '../components/layout/Base.astro';
import { site, issueUrl } from '../lib/site.js';

const forms = [
  {
    template: 'add-device',
    label: 'Add a device',
    hint: "A phone that a ROM supports but we don't list",
  },
  {
    template: 'report-feature',
    label: 'Report what works',
    hint: 'VoLTE, NFC, Android Auto and the rest, on one ROM and phone',
  },
  { template: 'correction', label: 'Fix a mistake', hint: 'Anything wrong on a page' },
];
---

<Base
  title="Contribute"
  description="Add a device, report what works on a ROM, or fix a mistake. Everything lives in YAML files on GitHub."
  crumbs={[{ label: 'Contribute', url: '/contribute/' }]}
>
  <section>
    <h1>Contribute</h1>
    <p>
      All the data is plain YAML on GitHub, so anyone can add to it. Fill in a form, or edit the
      files yourself. Every page has an edit link at the bottom.
    </p>
  </section>

  <section aria-labelledby="forms">
    <h2 id="forms">Quickest: fill in a form</h2>
    <ul>
      {forms.map((form) => (
        <li>
          <a href={issueUrl(form.template)}>{form.label}</a> <span>{form.hint}</span>
        </li>
      ))}
    </ul>
    <p>
      A report turns into a pull request by itself, with your name on it. If something's missing,
      the bot comments on the issue saying what, and tries again when you edit it.
    </p>
  </section>

  <section aria-labelledby="edit">
    <h2 id="edit">Or edit the data</h2>
    <p>
      The <a href={`${site.repo}/blob/main/.github/CONTRIBUTING.md`}>contributing guide</a> shows
      where each file lives, what to copy, and how to check your change. You can do the whole thing
      in GitHub's web editor.
    </p>
    <p>
      Leave <code>data/upstream/</code> alone though. It's rebuilt from each ROM's own device list
      every Monday, so edits there don't last a week. If it's wrong, it's wrong at the source, and
      the <a href={issueUrl('correction')}>fix a mistake</a> form is the way to tell us.
    </p>
    <p>
      Always link a source. A ROM's own device page, wiki or changelog is best. A "works for me"
      from a forum is fine too, just say so in a note.
    </p>
  </section>
</Base>

<style>
  ul {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
  }

  span {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
