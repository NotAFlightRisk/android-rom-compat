---
import Base from '../components/layout/Base.astro';
import RomSummary from '../components/cards/RomSummary.astro';
import Logo from '../components/ui/Logo.astro';
import Search from '../components/ui/Search.astro';
import { getModel } from '../lib/data/model.js';
import { formatDate } from '../lib/dates.js';
import { site } from '../lib/site.js';
import { listOf, plural } from '../lib/text.js';

const { devices, roms } = getModel();
const live = roms.filter((rom) => rom.status === 'active');
const popular = devices
  .filter((device) => device.activeCount > 0)
  .toSorted((a, b) => b.activeCount - a.activeCount || (b.released ?? 0) - (a.released ?? 0))
  .slice(0, 10);
const recent = devices
  .filter((device) => device.latestBuild)
  .toSorted((a, b) => b.latestBuild.localeCompare(a.latestBuild) || a.title.localeCompare(b.title))
  .slice(0, 8);
const builtBy = (device) =>
  device.support
    .filter((row) => row.latest?.date === device.latestBuild)
    .map((row) => row.rom.name)
    .join(', ');
---

<Base
  headerSearch={false}
  title={site.name}
  description={`Which custom ROMs run on your Android phone, what works, and whether the bootloader unlocks. Covers ${listOf(
    live.map((rom) => rom.name),
    'and',
  )}.`}
>
  <section class="intro">
    <h1>What can your phone run?</h1>
    <p>Official ROM support for {devices.length} Android devices, and what works on each.</p>
    <Search id="home-search" label="Find your phone" large />
  </section>

  <div class="columns">
    <section aria-labelledby="popular">
      <h2 id="popular">Most supported</h2>
      <ol class="rows">
        {popular.map((device) => (
          <li>
            <Logo kind="brands" item={device.brand} size="sm" />
            <a href={device.url}>{device.title}</a>
            <span>{plural(device.activeCount, 'ROM')}</span>
          </li>
        ))}
      </ol>
    </section>

    {recent.length > 0 && (
      <section aria-labelledby="recent">
        <h2 id="recent">Recently built</h2>
        <ol class="rows">
          {recent.map((device) => (
            <li>
              <Logo kind="brands" item={device.brand} size="sm" />
              <a href={device.url}>{device.title}</a>
              <span>
                {builtBy(device)},{' '}
                <time datetime={device.latestBuild}>{formatDate(device.latestBuild)}</time>
              </span>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>

  <section aria-labelledby="roms">
    <h2 id="roms">ROMs</h2>
    <ul class="roms">
      {live.map((rom) => (
        <li>
          <RomSummary rom={rom} />
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro {
    justify-items: start;
    gap: var(--space-sm);
    padding-block: var(--space-xl) var(--space-lg);

    p {
      color: var(--text-muted);
      font-size: var(--text-lg);
    }

    :global(form) {
      inline-size: min(100%, 40rem);
      margin-block-start: var(--space-sm);
    }
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-xl);
  }

  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--border);

    > span {
      color: var(--text-muted);
      font-size: var(--text-sm);
      text-align: end;
    }
  }

  .roms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-md);

    > li {
      display: grid;
    }
  }
</style>
