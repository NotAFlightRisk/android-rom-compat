---
// The Lucide icons the site uses, by name. Each renders as inline SVG at build time, text-sized
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import BookOpen from '@lucide/astro/icons/book-open';
import CodeXml from '@lucide/astro/icons/code-xml';
import Columns3 from '@lucide/astro/icons/columns-3';
import Flag from '@lucide/astro/icons/flag';
import Globe from '@lucide/astro/icons/globe';
import LayoutGrid from '@lucide/astro/icons/layout-grid';
import MessagesSquare from '@lucide/astro/icons/messages-square';
import Pencil from '@lucide/astro/icons/pencil';
import Search from '@lucide/astro/icons/search';
import Table2 from '@lucide/astro/icons/table-2';

const icons = {
  cards: LayoutGrid,
  columns: Columns3,
  community: MessagesSquare,
  docs: BookOpen,
  edit: Pencil,
  external: ArrowUpRight,
  install: BookOpen,
  report: Flag,
  search: Search,
  source: CodeXml,
  table: Table2,
  website: Globe,
};

const { name, label } = Astro.props;
const Glyph = icons[name];
if (!Glyph) throw new Error(`There's no icon called "${name}" in Icon.astro`);
---

<Glyph
  size="1em"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
/>
