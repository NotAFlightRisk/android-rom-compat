---
const { name, label } = Astro.props;
const paths = {
  search: 'M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM15.5 15.5L20 20',
  note: 'M12 11v5M12 8v.1M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z',
  columns: 'M4 5h16v14H4zM9.5 5v14M14.5 5v14',
  external: 'M14 5h5v5M19 5l-8 8M17 14v5H5V7h5',
  edit: 'M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4',
};
---

<svg
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d={paths[name]} />
</svg>
