---
// A brand or ROM mark on a plate, or its initials when src/assets/logos/ has no file for it
const marks = import.meta.glob('../../assets/logos/*/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const urls = import.meta.glob('../../assets/logos/*/*.svg', {
  query: '?url',
  import: 'default',
  eager: true,
});

const { kind, item, size = 'md' } = Astro.props;
const file = `../../assets/logos/${kind}/${item.key}.svg`;
const [, , width, height] =
  marks[file]
    ?.match(/viewBox="([^"]+)"/)[1]
    .split(' ')
    .map(Number) ?? [];
const aspect = width / height;
// A wordmark too wide to read on the smallest plate gives way to initials, as a missing logo does
const legible = urls[file] && !(size === 'xs' && aspect > 2.5);
const initials = item.name.length <= 3 ? item.name : item.name.match(/[a-z0-9]/i)[0].toUpperCase();
---

<span class="logo" data-size={size} aria-hidden="true">
  {legible ? (
    <span class="mark" style={`--mark: url(${urls[file]}); --aspect: ${aspect}`} />
  ) : (
    <span class="initials">{initials}</span>
  )}
</span>

<style>
  .logo {
    --size: 2.5rem;
    /* How wide and how tall a mark may get, in plate heights */
    --widest: 1.5;
    --tallest: 0.56;
    display: inline-grid;
    place-items: center;
    flex: none;
    block-size: var(--size);
    min-inline-size: var(--size);
    padding-inline: calc(var(--size) * 0.2);
    border: 1px solid var(--border);
    border-radius: calc(var(--size) * 0.28);
    background: var(--surface-raised);
    color: var(--text);

    /* A line of text high, so every plate is square and the names beside them line up */
    &[data-size='xs'] {
      --size: 1.5rem;
      --widest: 0.85;
      --tallest: 0.7;
      padding: 0;

      .initials {
        font-size: calc(var(--size) * 0.5);
      }
    }

    &[data-size='sm'] {
      --size: 1.75rem;
    }

    &[data-size='lg'] {
      --size: 3.5rem;
    }
  }

  /* Wide wordmarks get shorter, so no plate grows past --widest squares */
  .mark {
    block-size: calc(var(--size) * min(var(--tallest), var(--widest) / var(--aspect)));
    aspect-ratio: var(--aspect);
    background: currentColor;
    mask: var(--mark) center / contain no-repeat;
    print-color-adjust: exact;

    @media (forced-colors: active) {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }

  .initials {
    color: var(--text-muted);
    font-size: calc(var(--size) * 0.36);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
</style>
