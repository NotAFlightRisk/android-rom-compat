---
// Labelled facts. A tone shows the answer as a status, and a panel boxes them up as a summary
import Icon from './Icon.astro';

const { items, panel = false } = Astro.props;
const shown = items.filter((item) => item.value !== undefined && item.value !== '');
---

<dl class:list={{ panel }}>
  {shown.map((item) => (
    <div>
      <dt>{item.label}</dt>
      <dd>
        {item.tone ? (
          <span class="status" data-tone={item.tone}>
            {item.value}
          </span>
        ) : item.code ? (
          <code>{item.value}</code>
        ) : (
          item.value
        )}
        {item.note && <p>{item.note}</p>}
        {item.source && (
          <a href={item.source}>
            {new URL(item.source).hostname} <Icon name="external" />
          </a>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-md) var(--space-lg);
    margin: 0;
  }

  dt {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  dd {
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
    margin: 0;
    font-weight: 500;

    p {
      color: var(--text-muted);
      font-size: var(--text-sm);
      font-weight: 400;
    }

    a {
      font-size: var(--text-sm);
      font-weight: 400;
    }
  }

  .panel {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;

    > div {
      display: grid;
      align-content: start;
      gap: var(--space-xs);
      padding: var(--space-md);
      /* Dividers between panels, whichever way they wrap */
      box-shadow: -1px -1px 0 var(--border);
    }

    dd {
      font-size: var(--text-lg);
    }
  }
</style>
