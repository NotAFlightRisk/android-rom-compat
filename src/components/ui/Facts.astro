---
// Labelled facts, one to a row, or boxed up side by side as a panel. A tone shows the answer as a
// status, a list of answers shows as badges, and an answer can bring a logo and a link
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const { items, panel = false } = Astro.props;
const shown = items.filter((item) => item.text?.length > 0);
---

<dl class:list={{ panel }}>
  {shown.map((item) => (
    <div>
      <dt>{item.label}</dt>
      <dd>
        {Array.isArray(item.text) ? (
          <ul class="badges">
            {item.text.map((part) => (
              <li class="badge">{part}</li>
            ))}
          </ul>
        ) : item.tone ? (
          <span class="status" data-tone={item.tone}>
            {item.text}
          </span>
        ) : (
          <span class="answer">
            {item.logo && <Logo {...item.logo} size="xs" />}
            {item.href ? <a href={item.href}>{item.text}</a> : item.text}
          </span>
        )}
        {item.note && <p>{item.note}</p>}
        {item.source && (
          <a class="source" href={item.source}>
            {new URL(item.source).hostname} <Icon name="external" />
          </a>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  dl {
    display: grid;
    margin: 0;
  }

  dt {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  dd {
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
    margin: 0;
    font-weight: 500;

    p {
      color: var(--text-muted);
      font-size: var(--text-sm);
      font-weight: 400;
    }

    .source {
      font-size: var(--text-sm);
      font-weight: 400;
    }
  }

  .answer {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);

    :global(.logo) {
      align-self: center;
    }
  }

  /* Rows share the columns, so the answers line up and read down as one list */
  dl:not(.panel) {
    grid-template-columns: auto 1fr;
    column-gap: var(--space-lg);

    > div {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: baseline;
      padding-block: var(--space-xs);
    }

    > div + div {
      border-block-start: 1px solid var(--border);
    }
  }

  .panel {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-card);

    > div {
      display: grid;
      align-content: start;
      gap: var(--space-xs);
      padding: var(--space-md);
      /* Dividers between panels, whichever way they wrap */
      box-shadow: -1px -1px 0 var(--border);
    }

    dd {
      font-size: var(--text-lg);
    }
  }
</style>
