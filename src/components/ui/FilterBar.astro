---
// Search and dropdowns that filter the cards and the table together. Hidden without JS
import Icon from './Icon.astro';

const {
  controls,
  label,
  total,
  brands = [],
  roms = [],
  unlock = false,
  endedCount = 0,
} = Astro.props;
const unlocks = [
  ['yes', 'Unlocks'],
  ['conditional', 'Unlocks, with conditions'],
  ['no', "Doesn't unlock"],
  ['unknown', 'Unknown'],
];
---

<form
  class="filters"
  data-filter
  data-controls
  aria-label={label}
  aria-controls={controls.join(' ')}
>
  <label class="search">
    <span class="visually-hidden">Name, codename or model</span>
    <Icon name="search" />
    <input
      type="search"
      name="q"
      placeholder="Name, codename or model"
      autocomplete="off"
      spellcheck="false"
    />
  </label>
  {brands.length > 1 && (
    <label>
      <span class="visually-hidden">Brand</span>
      <select name="brand">
        <option value="">All brands</option>
        {brands.map((brand) => (
          <option value={brand.key}>{brand.name}</option>
        ))}
      </select>
    </label>
  )}
  {roms.length > 1 && (
    <label>
      <span class="visually-hidden">ROM</span>
      <select name="rom">
        <option value="">Any ROM</option>
        {roms.map((rom) => (
          <option value={rom.key}>{rom.name}</option>
        ))}
      </select>
    </label>
  )}
  {unlock && (
    <label>
      <span class="visually-hidden">Bootloader</span>
      <select name="unlock">
        <option value="">Any bootloader</option>
        {unlocks.map(([value, text]) => (
          <option value={value}>{text}</option>
        ))}
      </select>
    </label>
  )}
  {endedCount > 0 && (
    <label class="check">
      <input type="checkbox" name="ended" />
      Include ended support
    </label>
  )}
  <p class="count" role="status" data-count>
    {total} shown
  </p>
  <p class="empty" data-empty hidden>
    Nothing matches. Try fewer filters, or search by codename or model number.
  </p>
  {endedCount > 0 && (
    <p class="empty" data-empty-ended hidden>
      Only devices whose support has ended match that. Tick “Include ended support” to see them.
    </p>
  )}
</form>

<script>
  import { enhanceFilter } from '../../scripts/filter.js';
  document.querySelectorAll('[data-filter]').forEach(enhanceFilter);
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 16rem;
    max-inline-size: 22rem;

    :global(svg) {
      position: absolute;
      inset-inline-start: var(--space-sm);
      color: var(--text-muted);
      pointer-events: none;
    }

    input {
      inline-size: 100%;
      padding-inline-start: 2.25rem;
    }
  }

  select {
    max-inline-size: 100%;
  }

  .check {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: var(--control);
    padding-inline: var(--space-xs);
    cursor: pointer;
  }

  .count {
    margin-inline-start: auto;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .empty {
    flex-basis: 100%;
    max-inline-size: none;
    padding: var(--space-lg);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
    text-align: center;
  }
</style>
