---
// Search, a sort and a tray of filters for the cards and the table together. Needs JS
import Icon from './Icon.astro';
import Select from './Select.astro';

const { controls, label, total, filters = [], endedCount = 0 } = Astro.props;
const tray = `${controls[0]}-filters`;
const orders = [
  ['', 'A to Z'],
  ['newest', 'Newest first'],
  ['roms', 'Most ROMs first'],
];
---

<form
  class="filters"
  data-filter
  data-controls
  aria-label={label}
  aria-controls={controls.join(' ')}
>
  <label class="search">
    <span class="visually-hidden">Name, codename or model</span>
    <Icon name="search" />
    <input
      type="search"
      name="q"
      placeholder="Name, codename or model"
      autocomplete="off"
      spellcheck="false"
    />
  </label>
  {(filters.length > 0 || endedCount > 0) && (
    <button type="button" class="button toggle" aria-expanded="false" aria-controls={tray}>
      <Icon name="filters" /> Filters <span class="tally" data-tally hidden />
    </button>
  )}
  <Select name="order" label="Sort" options={orders} data-view="cards" />
  <p class="count" role="status" data-count>
    {total} shown
  </p>
  <div class="tray" id={tray} hidden>
    {filters.map(({ name, label, any, options, logos }) => (
      <Select name={name} label={label} options={[['', any], ...options]} logos={logos} />
    ))}
    {endedCount > 0 && (
      <label class="check">
        <input type="checkbox" name="ended" />
        Include ended support
      </label>
    )}
    <button type="button" class="button ghost small" data-clear hidden>
      Clear filters
    </button>
  </div>
  <div class="empty" data-empty hidden>
    <p>Nothing matches. Try fewer filters, or search by codename or model number.</p>
    <button type="button" class="button small" data-clear>
      Clear filters
    </button>
  </div>
  {endedCount > 0 && (
    <div class="empty" data-empty-ended hidden>
      <p>Only devices whose support has ended match that.</p>
      <button type="button" class="button small" data-show-ended>
        Include ended support
      </button>
    </div>
  )}
</form>

<script>
  import { enhanceFilter } from '../../scripts/filter.js';
  document.querySelectorAll('[data-filter]').forEach(enhanceFilter);
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 16rem;
    max-inline-size: 22rem;

    :global(svg) {
      position: absolute;
      inset-inline-start: var(--space-sm);
      color: var(--text-muted);
      pointer-events: none;
    }

    input {
      inline-size: 100%;
      padding-inline-start: 2.25rem;
    }
  }

  .toggle[aria-expanded='true'] {
    border-color: var(--text-muted);
    background: var(--surface-raised);
  }

  .tally {
    min-inline-size: 1.25rem;
    padding-inline: var(--space-2xs);
    border-radius: var(--radius-pill);
    background: var(--accent-strong);
    color: var(--on-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.25rem;
    text-align: center;
  }

  .count {
    margin-inline-start: auto;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .tray {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    flex-basis: 100%;
    gap: var(--space-xs);
    padding: var(--space-sm);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    transition:
      opacity 150ms ease-out,
      translate 150ms ease-out;

    @starting-style {
      opacity: 0;
      translate: 0 calc(-1 * var(--space-2xs));
    }
  }

  /* Boxed like the dropdowns beside it, so the whole thing is one target */
  .check {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: var(--control);
    padding-inline: var(--space-sm);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer;

    &:hover {
      border-color: var(--text-muted);
    }
  }

  .tray [data-clear] {
    margin-inline-start: auto;
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    flex-basis: 100%;
    padding: var(--space-lg);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
    text-align: center;
  }

  @media (width < 40rem) {
    .search {
      flex-basis: 100%;
      max-inline-size: none;
    }

    .filters :global(label:has(select)),
    .check {
      flex: 1 1 40%;
    }

    .filters :global(select) {
      inline-size: 100%;
    }
  }
</style>
