---
// One ROM on one device: its build, what it needs, what works, and where to install it from
import FeatureList from './FeatureList.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import { buildFact, googleApps, knownFeatures, needsOf, relockFact } from '../../lib/facts.js';
import { formatDate } from '../../lib/dates.js';
import { reportUrl } from '../../lib/table.js';

const { row, features } = Astro.props;
const { rom, device } = row;
const build = buildFact(row.latest);
const relock = relockFact(row);
const needs = needsOf(row);
const known = knownFeatures(features, row.cells);
const builds = row.variants.filter((variant) => variant.status === 'active');
const id = `rom-${rom.key}`;
---

<article class="card rom" aria-labelledby={id}>
  <div class="head">
    <Logo kind="roms" item={rom} />
    <div>
      <h3 id={id}>
        <a href={rom.url}>{rom.name}</a>
      </h3>
      <p>{googleApps(rom)}</p>
    </div>
    {row.android && <span class="badge">Android {row.android}</span>}
  </div>

  <ul class="facts">
    {build && (
      <li class="build" data-tone={build.tone}>
        Built <time datetime={build.date}>{build.text}</time>
        {build.old && <strong>· {build.old}</strong>}
      </li>
    )}
    {build?.patch && <li>{build.patch} security patch</li>}
    {relock && (
      <li class="relock">
        <span class="status" data-tone={relock.tone}>
          {relock.text}
        </span>
        {relock.note && <small>{relock.note}</small>}
      </li>
    )}
    {needs.map((need) => (
      <li class="badge">{need}</li>
    ))}
  </ul>

  {known.length > 0 && <FeatureList items={known} />}

  {builds.map((variant) => (
    <p class="also">
      Also as <a href={variant.source}>{variant.name}</a>
      {variant.latest && <>, built {formatDate(variant.latest.date)}</>}
    </p>
  ))}

  <div class="actions">
    {row.install ? (
      <a class="button primary small" href={row.install}>
        <Icon name="install" /> Install guide
      </a>
    ) : (
      <a class="button small" href={row.source}>
        {rom.name} device page <Icon name="external" />
      </a>
    )}
    <a class="button ghost small" href={reportUrl(device, rom)}>
      <Icon name="report" /> Report what works
    </a>
  </div>
</article>

<style>
  .rom {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-sm);

    h3 a {
      color: var(--text);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }

    p {
      color: var(--text-muted);
      font-size: var(--text-sm);
    }
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  /* Freshness shows as a dot, and in words once a build is old */
  .build {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);

    &::before {
      content: '';
      inline-size: 0.5rem;
      block-size: 0.5rem;
      margin-inline-end: var(--space-2xs);
      border-radius: 50%;
      background: var(--tone-text);
    }

    strong {
      color: var(--broken-text);
      font-weight: 500;
    }
  }

  .relock {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-xs);
  }

  .also {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: auto;
  }
</style>
