---
import Cell from './Cell.astro';
import Controls from './Controls.astro';

const {
  id,
  caption,
  rowLabel,
  columns,
  rows,
  brands = [],
  controls = true,
  urlState = false,
} = Astro.props;
const endedCount = rows.filter((row) => row.ended).length;
---

<div class="matrix" data-matrix data-url-state={urlState ? '' : undefined}>
  {controls && (
    <Controls
      id={id}
      columns={columns}
      brands={brands}
      total={rows.length}
      endedCount={endedCount}
    />
  )}
  <div class="scroller" tabindex="0" role="region" aria-labelledby={`${id}-caption`}>
    <table id={id}>
      <caption id={`${id}-caption`}>{caption}</caption>
      <thead>
        <tr>
          <th scope="col" data-col="name">
            {rowLabel}
          </th>
          {columns.map((column) => (
            <th
              scope="col"
              data-col={column.key}
              data-group={column.group}
              hidden={column.hidden}
              title={column.description}
            >
              {column.label}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr data-search={row.search} data-brand={row.brand} data-ended={row.ended ? '' : undefined}>
            <th scope="row">
              <a href={row.head.href}>{row.head.label}</a>
              {row.head.code && <code>{row.head.code}</code>}
              {row.head.links?.map((link) => (
                <a class="minor" href={link.href}>
                  {link.label}
                </a>
              ))}
              {row.head.builds?.map((link) => (
                <a class="build" href={link.href}>
                  {link.label}
                </a>
              ))}
            </th>
            {columns.map((column) => (
              <Cell
                id={`${id}-${row.key}-${column.key}`}
                column={column}
                cell={row.cells[column.key]}
              />
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {controls && (
    <p class="empty" data-empty hidden>
      Nothing matches that. Try a codename or model number.
    </p>
  )}
  {controls && endedCount > 0 && (
    <p class="empty" data-empty-ended hidden>
      Only phones whose support has ended match that. Tick “Include ended” to see them.
    </p>
  )}
</div>

<script>
  import { enhanceMatrix } from '../../scripts/matrix.js';
  document.querySelectorAll('[data-matrix]').forEach(enhanceMatrix);
</script>

<style is:global>
  .matrix {
    display: grid;
    gap: var(--space-sm);
    min-inline-size: 0;

    .scroller {
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overscroll-behavior-inline: contain;

      &[data-more] {
        mask-image: linear-gradient(to left, transparent, #000 2.5rem);
      }

      @media (width >= 48rem) {
        max-block-size: 75dvh;
      }
    }

    table {
      inline-size: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: var(--text-sm);
    }

    caption {
      padding: var(--space-sm) var(--space-md);
      border-block-end: 1px solid var(--border);
      text-align: start;
      font-weight: 600;
    }

    th,
    td {
      padding: var(--space-xs) var(--space-sm);
      border-block-end: 1px solid var(--border);
      text-align: start;
      white-space: nowrap;
    }

    tr:last-child > * {
      border-block-end: 0;
    }

    thead th {
      position: sticky;
      inset-block-start: 0;
      z-index: 2;
      background: var(--surface-raised);
      color: var(--text-muted);
      font-weight: 600;
      vertical-align: bottom;

      &:first-child {
        inset-inline-start: 0;
        z-index: 3;
        border-inline-end: 1px solid var(--border);
      }
    }

    th[scope='row'] {
      position: sticky;
      inset-inline-start: 0;
      z-index: 1;
      min-inline-size: 11rem;
      max-inline-size: 16rem;
      border-inline-end: 1px solid var(--border);
      background: var(--surface);
      font-weight: 500;
      white-space: normal;

      a {
        display: block;
        min-block-size: 1.5rem;
        line-height: 1.5rem;
      }

      code {
        display: block;
      }

      .minor {
        display: inline-block;
        margin-inline-end: var(--space-sm);
      }

      code,
      .minor,
      .build {
        font-size: var(--text-xs);
        font-weight: 400;
      }

      code {
        color: var(--text-muted);
      }
    }

    thead th {
      padding-inline-end: calc(var(--space-sm) + 1.15em);

      &:has(button) {
        padding-inline-end: var(--space-sm);
      }
    }

    thead button {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      padding: 0;
      border: 0;
      background: none;
      font-weight: inherit;
      text-align: start;
      cursor: pointer;

      &::after {
        content: '';
        inline-size: 0.9em;
        block-size: 0.9em;
        background: currentColor;
        mask: url('/icons/sort.svg') center / contain no-repeat;
        opacity: 0.4;
      }

      &:hover {
        color: var(--text);
      }
    }

    [aria-sort] button::after {
      opacity: 1;
    }

    [aria-sort='ascending'] button::after {
      mask-image: url('/icons/sort-up.svg');
    }

    [aria-sort='descending'] button::after {
      mask-image: url('/icons/sort-down.svg');
    }

    td code {
      font-size: 1em;
    }

    tbody tr:hover > * {
      background-image: linear-gradient(var(--accent-soft), var(--accent-soft));
    }

    .empty {
      padding: var(--space-lg);
      color: var(--text-muted);
      text-align: center;
    }
  }
</style>
