---
import Icon from '../ui/Icon.astro';
import { labelOf } from '../../lib/labels.js';

const { id, columns, brands, total } = Astro.props;
const groups = Map.groupBy(columns, (column) => column.group ?? '');
---

<div class="controls" data-controls>
  <label>
    <span class="visually-hidden">Filter rows</span>
    <input type="search" name="q" placeholder="Filter" autocomplete="off" aria-controls={id} />
  </label>
  {brands.length > 1 && (
    <label>
      <span class="visually-hidden">Brand</span>
      <select name="brand">
        <option value="">All brands</option>
        {brands.map((brand) => (
          <option value={brand.key}>{brand.name}</option>
        ))}
      </select>
    </label>
  )}
  <details>
    <summary>
      <Icon name="columns" /> Columns
    </summary>
    <div class="picker">
      {[...groups].map(([group, list]) => (
        <fieldset>
          <legend class:list={{ 'visually-hidden': !group }}>
            {group ? labelOf(group) : 'Show columns'}
          </legend>
          {list.map((column) => (
            <label>
              <input
                type="checkbox"
                name="col"
                value={column.key}
                checked={!column.hidden}
                aria-controls={id}
              />
              {column.label}
            </label>
          ))}
        </fieldset>
      ))}
    </div>
  </details>
  <p role="status" data-count>
    {total} shown
  </p>
</div>

<style>
  .controls {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  input[type='search'] {
    inline-size: 14rem;
    max-inline-size: 100%;
  }

  details {
    @media (width >= 48rem) {
      position: relative;
    }
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: 2.5rem;
    padding-inline: var(--space-sm);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      border-color: var(--text-muted);
    }
  }

  .picker {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2xs));
    z-index: 3;
    display: grid;
    gap: var(--space-sm);
    inline-size: min(36rem, 90vw);
    max-block-size: 70dvh;
    overflow-y: auto;
    padding: var(--space-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);

    @media (width < 48rem) {
      inset-inline: 0;
      inline-size: auto;
    }
  }

  fieldset {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    margin: 0;
    padding: 0;
    border: 0;

    legend {
      padding: 0 var(--space-2xs) var(--space-2xs);
      color: var(--text-muted);
      font-size: var(--text-sm);
      font-weight: 600;
    }

    label {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      padding: var(--space-2xs);
      cursor: pointer;
    }
  }

  [data-count] {
    margin-inline-start: auto;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
