---
const { id, column, cell } = Astro.props;
const noteId = `${id}-note`;
---

<td data-tone={cell.tone} class:list={{ masked: cell.tone }} hidden={column.hidden}>
  {cell.date ? (
    <time datetime={cell.date}>{cell.text ?? cell.date}</time>
  ) : cell.code ? (
    <code>{cell.text}</code>
  ) : cell.href ? (
    <a href={cell.href}>{cell.text}</a>
  ) : (
    cell.text
  )}
  {cell.chips?.map((chip) => (
    <span class="chip">{chip}</span>
  ))}
  {cell.stale && <span class="stale masked">{cell.stale}</span>}
  {cell.note && (
    <>
      <button
        type="button"
        class="note masked"
        popovertarget={noteId}
        aria-label={`Note on ${column.label}`}
        aria-describedby={noteId}
      ></button>
      <span popover id={noteId}>
        <strong>{column.label}:</strong> {cell.note}
        {cell.source && <a href={cell.source}>Source</a>}
      </span>
    </>
  )}
</td>

<style is:global>
  .matrix {
    td[data-tone] {
      background: var(--tone-bg);
      color: var(--tone-text);
    }

    .masked::before {
      margin-inline-end: var(--space-2xs);
      vertical-align: -0.15em;
    }

    .stale {
      --icon: url('/icons/stale.svg');
      margin-inline-start: var(--space-2xs);
      padding-inline: var(--space-2xs);
      border-radius: var(--radius-sm);
      background: var(--partial-bg);
      color: var(--partial-text);
      font-size: var(--text-xs);
    }

    .chip {
      display: inline-block;
      padding-inline: var(--space-2xs);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      color: var(--text);
      font-size: var(--text-xs);

      & + & {
        margin-inline-start: var(--space-2xs);
      }
    }

    .note {
      --icon: url('/icons/note.svg');
      display: inline-grid;
      place-items: center;
      margin-inline-start: var(--space-2xs);
      padding: var(--space-2xs);
      border: 0;
      border-radius: var(--radius-pill);
      background: none;
      vertical-align: middle;
      cursor: pointer;

      &::before {
        margin: 0;
      }

      &:hover {
        background: color-mix(in srgb, currentColor 15%, transparent);
      }
    }

    [popover] {
      max-inline-size: min(22rem, 90vw);
      padding: var(--space-sm) var(--space-md);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--text);
      box-shadow: var(--shadow);
      white-space: normal;

      a {
        margin-inline-start: var(--space-2xs);
      }
    }
  }
</style>
