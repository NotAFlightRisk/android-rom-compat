---
import Icon from '../ui/Icon.astro';
import { site, nav, editUrl } from '../../lib/site.js';

const { edit, sources } = Astro.props;

const links = [
  ...nav,
  { label: 'Contribute', url: '/contribute/' },
  { label: 'About', url: '/about/' },
  { label: 'API', url: '/about/#api' },
  { label: 'Sitemap', url: '/sitemap/' },
];
---

<footer>
  {edit.length > 0 && (
    <>
      <p class="caution">
        <Icon name="warning" /> Flashing a ROM can brick your phone or void its warranty. Always
        follow the ROM's own install guide.
      </p>
      <dl>
        <dt>Edit on GitHub</dt>
        <dd>
          <ul class="files">
            {edit.map((file) => (
              <li>
                <a href={editUrl(file)} title={file.slice(file.indexOf('data/'))}>
                  {file.split('/').slice(-2).join('/')}
                </a>
              </li>
            ))}
          </ul>
        </dd>
        {sources.length > 0 && (
          <>
            <dt>Data from</dt>
            <dd>
              {sources.map((source, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={source.href}>{source.label}</a>
                </>
              ))}
            </dd>
          </>
        )}
      </dl>
    </>
  )}
  <div class="bar">
    <nav aria-label="Footer">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.url}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p>
      Code is <a href={`${site.repo}/blob/main/LICENSE`}>MIT</a>, data is{' '}
      <a href={`${site.repo}/blob/main/data/LICENSE`}>CC BY-SA 4.0</a> · ©&nbsp;
      <a href="https://github.com/NotAFlightRisk">@NotAFlightRisk</a>&nbsp;2026 ·{' '}
      <a href={site.repo}>Source on GitHub</a>
    </p>
  </div>
</footer>

<style>
  footer {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md) var(--gutter);
    border-block-start: 1px solid var(--border);
    background: var(--surface-raised);
    color: var(--text-muted);
    font-size: var(--text-sm);

    p {
      max-inline-size: none;
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  .caution :global(svg) {
    color: var(--partial-text);
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-md);
    margin: 0;
  }

  dt {
    color: var(--text);
    font-weight: 500;
  }

  dd {
    margin: 0;
  }

  .files {
    gap: var(--space-2xs) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);

    &:not(:first-child) {
      padding-block-start: var(--space-sm);
      border-block-start: 1px solid var(--border);
    }

    li + li::before {
      content: '·' / '';
      margin-inline: 0.25em;
    }

    @media (width < 52rem) {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
