---
import Icon from '../ui/Icon.astro';
import { site, editUrl } from '../../lib/site.js';

const { edit } = Astro.props;
---

<footer>
  <p>
    Flashing a ROM can brick your phone or void its warranty. Always follow the ROM's own install
    guide.
  </p>
  {edit.length > 0 && (
    <nav class="edit" aria-labelledby="edit-label">
      <span id="edit-label">
        <Icon name="edit" /> Edit on GitHub
      </span>
      <ul>
        {edit.map((file) => (
          <li>
            <a href={editUrl(file)} title={file.slice(file.indexOf('data/'))}>
              {file.split('/').slice(-2).join('/')}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <p>
    Code is <a href={`${site.repo}/blob/main/LICENSE`}>MIT</a>, data is{' '}
    <a href={`${site.repo}/blob/main/data/LICENSE`}>CC BY-SA 4.0</a>.{' '}
    <a href={site.repo}>Source on GitHub</a> · <a href="/about/">About</a> ·{' '}
    <a href="/about/#api">API</a>
  </p>
</footer>

<style>
  footer {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--space-md) var(--space-xl);
    border-block-start: 1px solid var(--border);
    background: var(--surface-raised);
    color: var(--text-muted);
    font-size: var(--text-sm);

    > * {
      inline-size: 100%;
      max-inline-size: var(--page);
      margin-inline: auto;
    }
  }

  .edit {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);

    span {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      color: var(--text);
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs) var(--space-md);
      margin: 0;
      padding: 0;
      list-style: none;
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }
  }
</style>
