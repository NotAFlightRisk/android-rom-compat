---
import Search from '../ui/Search.astro';
import { nav } from '../../lib/site.js';

const { search } = Astro.props;

const current = (url) => Astro.url.pathname.startsWith(url);
---

<header>
  <a class="home" href="/">
    <img src="/logo.svg" alt="" width="36" height="36" />
    <span>Android ROM Compat</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {nav.map((link) => (
        <li>
          <a href={link.url} aria-current={current(link.url) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {search && <Search />}
</header>

<style>
  header {
    display: grid;
    grid-template-columns: auto 1fr minmax(12rem, 20rem);
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding: var(--space-sm) var(--gutter);
    border-block-end: 1px solid var(--border);

    :global(form) {
      inline-size: 100%;
    }

    @media (width < 44rem) {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      column-gap: var(--space-sm);
    }
  }

  .home {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-weight: 500;
    text-decoration: none;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;

    @media (width < 44rem) {
      padding-inline: var(--space-xs);
    }

    &:hover {
      background: var(--surface-raised);
      color: var(--text);
    }

    &[aria-current='page'] {
      background: var(--accent-soft);
      color: var(--accent-text);
    }

    @media (forced-colors: active) {
      &[aria-current='page'] {
        forced-color-adjust: none;
        background: SelectedItem;
        color: SelectedItemText;
      }
    }
  }
</style>
