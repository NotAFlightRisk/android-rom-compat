{
  "$id": "brands.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brands",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["key", "name"],
    "additionalProperties": false,
    "properties": {
      "key": { "$ref": "#/$defs/key" },
      "name": { "type": "string", "minLength": 1 },
      "website": { "$ref": "#/$defs/link" },
      "bootloader": {
        "type": "object",
        "required": ["notes", "source"],
        "additionalProperties": false,
        "properties": {
          "unlock": { "enum": ["yes", "no", "conditional"] },
          "notes": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/link" }
        }
      },
      "unlock_costs": { "$ref": "#/$defs/costs" }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "lowercase letters, numbers and hyphens"
    },
    "link": { "type": "string", "format": "link", "pattern": "^https?://" },
    "costs": {
      "type": "object",
      "required": ["notes", "source"],
      "additionalProperties": false,
      "properties": {
        "notes": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/link" }
      }
    }
  }
}
