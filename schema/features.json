{
  "$id": "features.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Features",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["key", "group", "name", "description"],
    "additionalProperties": false,
    "properties": {
      "key": {
        "type": "string",
        "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
        "description": "lowercase letters, numbers and underscores"
      },
      "group": { "enum": ["calls", "google", "hardware", "media"] },
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "requires": {
        "type": "string",
        "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
        "description": "a hardware key, like nfc or esim"
      },
      "values": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 },
        "description": "allowed values, best first"
      }
    }
  }
}
